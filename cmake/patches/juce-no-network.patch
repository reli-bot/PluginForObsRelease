diff --git a/modules/juce_core/native/juce_Network_atk_disabled.cpp b/modules/juce_core/native/juce_Network_atk_disabled.cpp
new file mode 100644
index 0000000..c754164
--- /dev/null
+++ b/modules/juce_core/native/juce_Network_atk_disabled.cpp
@@ -0,0 +1,65 @@
+/*
+  atkAudio VST3-only build (JUCE_ATK_NO_NETWORK): replaces the platform networking code
+  (juce_Network_windows.cpp / juce_Network_linux.cpp). There is no HTTP client: every
+  URL / WebInputStream request fails immediately, and network adapters are never queried.
+  Licensed like the rest of JUCE (AGPLv3 here).
+*/
+
+namespace juce
+{
+
+class WebInputStream::Pimpl
+{
+public:
+    Pimpl (WebInputStream&, const URL&, bool) {}
+
+    void withExtraHeaders (const String&)           {}
+    void withCustomRequestCommand (const String&)   {}
+    void withConnectionTimeout (int)                {}
+    void withNumRedirectsToFollow (int)             {}
+
+    StringPairArray getRequestHeaders() const       { return {}; }
+    StringPairArray getResponseHeaders() const      { return {}; }
+    int getStatusCode() const                       { return 0; }
+
+    bool connect (WebInputStream::Listener*)        { return false; }
+    bool isError() const                            { return true; }
+    void cancel()                                   {}
+
+    bool isExhausted()                              { return true; }
+    int64 getPosition()                             { return 0; }
+    int64 getTotalLength()                          { return -1; }
+    int read (void*, int)                           { return 0; }
+    bool setPosition (int64)                        { return false; }
+
+    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (Pimpl)
+};
+
+void MACAddress::findAllAddresses (Array<MACAddress>&)
+{
+}
+
+void IPAddress::findAllAddresses (Array<IPAddress>& result, bool includeIPv6)
+{
+    result.addIfNotAlreadyThere (IPAddress::local());
+
+    if (includeIPv6)
+        result.addIfNotAlreadyThere (IPAddress::local (true));
+}
+
+IPAddress IPAddress::getInterfaceBroadcastAddress (const IPAddress&)
+{
+    return {};
+}
+
+bool JUCE_CALLTYPE Process::openEmailWithAttachments (const String&, const String&, const String&, const StringArray&)
+{
+    return false;
+}
+
+std::unique_ptr<URL::DownloadTask> URL::downloadToFile (const File&, const DownloadTaskOptions&)
+{
+    return nullptr;
+}
+
+} // namespace juce
diff --git a/modules/juce_core/network/juce_Socket_atk_disabled.cpp b/modules/juce_core/network/juce_Socket_atk_disabled.cpp
new file mode 100644
index 0000000..0964f4b
--- /dev/null
+++ b/modules/juce_core/network/juce_Socket_atk_disabled.cpp
@@ -0,0 +1,53 @@
+/*
+  atkAudio VST3-only build (JUCE_ATK_NO_NETWORK): socket support is compiled out.
+  Every StreamingSocket / DatagramSocket operation fails without touching the OS, so nothing
+  in this binary can open a network connection. Licensed like the rest of JUCE (AGPLv3 here).
+*/
+
+namespace juce
+{
+
+StreamingSocket::StreamingSocket() = default;
+
+StreamingSocket::StreamingSocket (const String& host, int portNum, int h, const SocketOptions& optionsIn)
+    : options (optionsIn), hostName (host)
+{
+    ignoreUnused (portNum, h);
+}
+
+StreamingSocket::~StreamingSocket() = default;
+
+int StreamingSocket::read (void*, int, bool)                     { return -1; }
+int StreamingSocket::write (const void*, int)                    { return -1; }
+int StreamingSocket::waitUntilReady (bool, int)                  { return -1; }
+bool StreamingSocket::bindToPort (int)                           { return false; }
+bool StreamingSocket::bindToPort (int, const String&)            { return false; }
+int StreamingSocket::getBoundPort() const noexcept               { return -1; }
+bool StreamingSocket::connect (const String&, int, int)          { return false; }
+void StreamingSocket::close()                                    { connected = false; isListener = false; }
+bool StreamingSocket::createListener (int, const String&)        { return false; }
+StreamingSocket* StreamingSocket::waitForNextConnection() const  { return nullptr; }
+bool StreamingSocket::isLocal() const noexcept                   { return false; }
+
+//==============================================================================
+DatagramSocket::DatagramSocket (bool, const SocketOptions& optionsIn)
+    : options (optionsIn)
+{
+}
+
+DatagramSocket::~DatagramSocket() = default;
+
+void DatagramSocket::shutdown()                                                  {}
+bool DatagramSocket::bindToPort (int)                                            { return false; }
+bool DatagramSocket::bindToPort (int, const String&)                             { return false; }
+int DatagramSocket::getBoundPort() const noexcept                                { return -1; }
+int DatagramSocket::waitUntilReady (bool, int)                                   { return -1; }
+int DatagramSocket::read (void*, int, bool)                                      { return -1; }
+int DatagramSocket::read (void*, int, bool, String&, int&)                       { return -1; }
+int DatagramSocket::write (const String&, int, const void*, int)                 { return -1; }
+bool DatagramSocket::joinMulticast (const String&)                               { return false; }
+bool DatagramSocket::leaveMulticast (const String&)                              { return false; }
+bool DatagramSocket::setMulticastLoopbackEnabled (bool)                          { return false; }
+bool DatagramSocket::setEnablePortReuse (bool)                                   { return false; }
+
+} // namespace juce
