1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@PLUGIN_AUTHOR@"
            VALUE "FileDescription", "@PLUGIN_RC_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@-vst3only"
            VALUE "InternalName", "@PROJECT_NAME@"
            VALUE "LegalCopyright", "(C) @PLUGIN_YEAR@ @PLUGIN_AUTHOR@. Licensed under the GNU AGPLv3."
            VALUE "OriginalFilename", "@PLUGIN_RC_ORIGINAL_FILENAME@"
            VALUE "ProductName", "@PLUGIN_DISPLAY_NAME@ for OBS @OBS_TARGET_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@-vst3only"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
